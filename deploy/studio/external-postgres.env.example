# Pin an immutable published Kortyx Studio release.
KORTYX_STUDIO_IMAGE_TAG=vX.Y.Z
KORTYX_COMPOSE_PROJECT_NAME=kortyx-studio

# Use sslmode=verify-full and the trust configuration required by your
# PostgreSQL provider whenever the database connection crosses a network.
DATABASE_URL=postgresql://kortyx:replace-me@postgres.example.com:5432/kortyx?sslmode=verify-full

# Generate independent random values. Never commit the populated file.
KORTYX_API_KEY_PEPPER=replace-with-at-least-32-random-bytes
KORTYX_TELEMETRY_API_KEY=ktyx_live_telemetry-id_replace-with-32-random-bytes
KORTYX_STUDIO_API_KEY=ktyx_live_studio-id_replace-with-32-random-bytes
KORTYX_STUDIO_BASIC_AUTH_USERNAME=admin
KORTYX_STUDIO_BASIC_AUTH_PASSWORD=replace-with-at-least-24-random-bytes

# Loopback is the safe single-VM default. A container platform can omit host
# port publication and route directly to container ports 6300 and 6400.
KORTYX_STUDIO_BIND_ADDRESS=127.0.0.1
KORTYX_API_BIND_ADDRESS=127.0.0.1
STUDIO_PORT=6300
API_PORT=6400
