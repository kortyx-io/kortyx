{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["**/.env"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [
        "dist/**",
        ".next/**",
        "!.next/cache/**",
        "!.next/dev/**",
        "out/**"
      ],
      "env": ["KORTYX_STUDIO_TSCONFIG"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": [],
      "outputs": [],
      "env": [
        "WEBSITE_PORT",
        "STUDIO_PORT",
        "KORTYX_STUDIO_TSCONFIG",
        "API_PORT",
        "DATABASE_URL",
        "KORTYX_API_KEY_PEPPER",
        "KORTYX_API_URL",
        "KORTYX_TELEMETRY_API_URL",
        "KORTYX_TELEMETRY_API_KEY",
        "KORTYX_TELEMETRY_ENVIRONMENT",
        "KORTYX_TELEMETRY_SERVICE_NAME",
        "KORTYX_TELEMETRY_DEPLOYMENT_REF",
        "KORTYX_TELEMETRY_CAPTURE_CONTENT",
        "KORTYX_STUDIO_API_KEY",
        "KORTYX_STUDIO_AUTH_MODE",
        "KORTYX_STUDIO_BASIC_AUTH_USERNAME",
        "KORTYX_STUDIO_BASIC_AUTH_PASSWORD",
        "KORTYX_NEXTJS_CHAT_PORT",
        "KORTYX_CANVAS_PORT",
        "NEXT_PUBLIC_KORTYX_API_URL",
        "GOOGLE_API_KEY",
        "KORTYX_EVAL_TARGETS_FILE",
        "KORTYX_EVAL_TARGETS",
        "KORTYX_EVAL_JUDGE_MODEL",
        "KORTYX_EVAL_JUDGE_API_KEY",
        "KORTYX_EVAL_JUDGE_BASE_URL",
        "KORTYX_EVAL_JUDGE_API",
        "KORTYX_EVAL_JUDGE_ID",
        "KORTYX_EVAL_JUDGE_VERSION"
      ]
    },
    "lint": {
      "outputs": []
    },
    "type-check": {
      "dependsOn": ["^build", "^type-check"],
      "env": ["KORTYX_STUDIO_TSCONFIG"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build", "^test"],
      "env": ["KORTYX_TEST_REDIS_URL", "KORTYX_TEST_POSTGRES_URL"],
      "outputs": [],
      "cache": false
    },
    "coverage": {
      "dependsOn": ["^build", "^coverage"],
      "env": ["KORTYX_TEST_REDIS_URL", "KORTYX_TEST_POSTGRES_URL"],
      "outputs": ["coverage/**"],
      "cache": false
    },
    "start": {
      "dependsOn": ["build"]
    }
  }
}
