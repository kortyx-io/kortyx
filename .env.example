WEBSITE_PORT=6200
STUDIO_PORT=6300
KORTYX_NEXTJS_CHAT_PORT=4100
KORTYX_CANVAS_PORT=4200

# Kortyx API / self-hosted Studio development auth
POSTGRES_PORT=6543
API_PORT=6400
DATABASE_URL=postgres://kortyx:kortyx@localhost:6543/kortyx
KORTYX_API_KEY_PEPPER=change-me-use-a-long-random-secret
KORTYX_API_URL=http://localhost:6400
KORTYX_TELEMETRY_API_KEY=ktyx_test_localtelemetry_oss-demo-telemetry-secret-change-me
KORTYX_STUDIO_API_KEY=ktyx_test_localstudio_oss-demo-studio-secret-change-me
# OSS bootstrap grants all Studio feature permissions without feature flags.
# Complete SDK error diagnostics are enabled by default; budgets belong on the API.
KORTYX_DIAGNOSTIC_RETENTION_DAYS=30
KORTYX_DIAGNOSTIC_PROJECT_BYTES=268435456

# Eval application targets: API-server file path (preferred) or inline JSON array.
# In Docker, mount the file and explicitly forward this API setting in an override.
# FILE takes precedence; targets default to []. Never commit actual service keys.
# KORTYX_EVAL_TARGETS_FILE=/run/secrets/kortyx-eval-targets.json
# KORTYX_EVAL_TARGETS=[]

# Optional Studio backend judge. Leave MODEL unset to disable Studio judging.
# A model requires its server-owned provider key. These do not configure the agent.
# API selects responses (default) or chat-completions; BASE_URL must use HTTPS.
# For OpenRouter: API=chat-completions, BASE_URL=https://openrouter.ai/api/v1,
# MODEL=<provider/model slug>. Set an explicit judge ID for custom endpoints.
# KORTYX_EVAL_JUDGE_MODEL=gpt-5.4-mini
# KORTYX_EVAL_JUDGE_API_KEY=
# KORTYX_EVAL_JUDGE_ID=studio/my-judge
# KORTYX_EVAL_JUDGE_VERSION=kortyx-rubric-v3
# KORTYX_EVAL_JUDGE_API=responses
# KORTYX_EVAL_JUDGE_BASE_URL=https://api.openai.com/v1

# Studio human access.
# Defaults: "none" in development, "basic" in production.
# "cloud" is reserved for the private managed Studio build.
KORTYX_STUDIO_AUTH_MODE=basic
KORTYX_STUDIO_BASIC_AUTH_USERNAME=admin
KORTYX_STUDIO_BASIC_AUTH_PASSWORD=kortyx

# Maintainer usage statistics, separate from customer Studio/OTel observability.
# Disabled stops collection; debug prints approved aggregates without sending.
# KORTYX_USAGE_TELEMETRY_DISABLED=1
# KORTYX_USAGE_TELEMETRY_DEBUG=1
# To use maintainer staging, set both its capture key and environment label.
# KORTYX_USAGE_TELEMETRY_POSTHOG_KEY=phc_...
# KORTYX_USAGE_TELEMETRY_ENVIRONMENT=staging
# Optional approved traffic label: internal, synthetic, external (default unknown).
# KORTYX_USAGE_TELEMETRY_TRAFFIC_SOURCE=internal

# Overall evaluation deadline (execution + Studio grading), and operator ceiling.
KORTYX_EVAL_RUN_TIMEOUT_MS=1800000
KORTYX_EVAL_MAX_RUN_TIMEOUT_MS=2147483647
