{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@studio/styles": ["./src/app/globals.css"],
      "@studio/onboarding": ["./src/onboarding/server.tsx"],
      "@/*": ["./src/*"],
      "@studio/auth": ["./src/auth/server.ts"],
      "@studio/auth-contracts": ["./src/auth/contracts.ts"],
      "@studio/settings": ["./src/settings/server.ts"],
      "@studio/settings-contracts": ["./src/settings/contracts.ts"],
      "@studio/shell": ["./src/shell/server.ts"],
      "@studio/shell-contracts": ["./src/shell/contracts.ts"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules"]
}
