{
  "name": "@kortyx/api",
  "version": "0.1.0",
  "private": true,
  "description": "Kortyx telemetry ingestion and Studio read API.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsup",
    "dev": "node scripts/run.mjs dev",
    "smoke:telemetry": "tsx scripts/smoke-telemetry.ts",
    "start": "node dist/index.js",
    "lint": "biome check src test",
    "test": "node --test scripts/profile.test.mjs && vitest run && pnpm -s type-check",
    "test:security-adapter": "node ../../test/api/security-build.mjs",
    "test:integration:ha": "vitest run test/ha.integration.test.ts",
    "type-check": "node scripts/run.mjs type-check"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.11",
    "@hono/swagger-ui": "^0.5.2",
    "@hono/zod-openapi": "^1.1.6",
    "@kortyx/telemetry-contracts": "workspace:*",
    "@kortyx/telemetry-db": "workspace:*",
    "hono": "^4.12.9",
    "zod": "catalog:",
    "@kortyx/agent": "workspace:*",
    "@kortyx/openai": "workspace:*",
    "@kortyx/openrouter": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsup": "catalog:",
    "tsx": "^4.21.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
