{
  "name": "kortyx-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "TypeScript framework for production AI agents with explicit workflows, provider-agnostic models, streaming, interrupts, and runtime persistence.",
  "keywords": [
    "ai",
    "agent",
    "agents",
    "llm",
    "orchestration",
    "workflow",
    "streaming",
    "typescript",
    "kortyx"
  ],
  "license": "SEE LICENSE IN LICENSE",
  "author": "Kortyx (https://github.com/kortyx-io)",
  "homepage": "https://github.com/kortyx-io/kortyx#readme",
  "bugs": {
    "url": "https://github.com/kortyx-io/kortyx/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kortyx-io/kortyx"
  },
  "packageManager": "pnpm@10.0.0+sha512.b8fef5494bd3fe4cbd4edabd0745df2ee5be3e4b0b8b08fa643aa3e4c6702ccc0f00d68fa8a8c9858a735a0032485a44990ed2810526c875e416f001b17df12b",
  "workspaces": [
    "apps/*",
    "examples/*",
    "packages/*",
    "providers/*"
  ],
  "scripts": {
    "build": "turbo build",
    "dev": "pnpm dev:prepare && pnpm dev:setup && pnpm dev:apps",
    "dev:apps": "dotenv -e .env -- turbo run dev --parallel --concurrency=20 --continue=dependencies-successful --filter=@kortyx/api --filter=kortyx-studio --filter=@kortyx/example-canvas",
    "dev:prepare": "turbo run build --filter=@kortyx/api --filter=@kortyx/telemetry --filter=kortyx --filter=@kortyx/google --filter=@kortyx/react",
    "dev:setup": "test -f .env || cp .env.example .env; pnpm dev:db && pnpm db:migrate && pnpm db:bootstrap",
    "dev:no-db": "pnpm dev:prepare && pnpm dev:apps",
    "dev:db": "docker compose up -d --wait postgres",
    "dev:api": "dotenv -e .env -- turbo run dev --concurrency=20 --continue=dependencies-successful --filter=@kortyx/api",
    "dev:studio": "dotenv -e .env -- turbo run dev --concurrency=20 --continue=dependencies-successful --filter=kortyx-studio",
    "dev:all": "dotenv -e .env -- turbo run dev --parallel --concurrency=50 --continue=dependencies-successful",
    "db:migrate": "dotenv -e .env -- pnpm --filter @kortyx/telemetry-db db:migrate",
    "db:bootstrap": "dotenv -e .env -- pnpm --filter @kortyx/telemetry-db db:bootstrap",
    "db:backfill-studio": "dotenv -e .env -- pnpm --filter @kortyx/telemetry-db db:backfill-studio",
    "db:studio": "dotenv -e .env -- pnpm --filter @kortyx/telemetry-db db:studio",
    "lint": "biome check .",
    "test": "turbo run test",
    "test:telemetry-db:integration": "dotenv -e .env -- pnpm --filter @kortyx/telemetry-db test:integration",
    "coverage": "turbo run coverage",
    "test:coverage": "pnpm coverage",
    "type-check": "turbo type-check",
    "type-check:watch": "turbo type-check --watch",
    "start": "turbo start",
    "clean": "rm -rf .turbo coverage apps/*/.next apps/*/dist apps/*/out apps/*/.turbo apps/*/coverage packages/*/dist packages/*/.turbo packages/*/coverage providers/*/dist providers/*/.turbo providers/*/coverage examples/*/.next examples/*/dist examples/*/out examples/*/.turbo examples/*/coverage && find . -name '*.tsbuildinfo' -not -path '*/node_modules/*' -delete",
    "clean:deps": "find . -name node_modules -type d -prune -exec rm -rf {} +",
    "clean:all": "pnpm clean && pnpm clean:deps",
    "format": "biome check --write .",
    "format:check": "biome check .",
    "prepare": "command -v husky >/dev/null 2>&1 && husky || echo 'Husky not available, skipping'"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.4",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@types/node": "catalog:",
    "dotenv-cli": "^11.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.5",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "@vitest/coverage-v8": "catalog:"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,css}": [
      "biome check --write"
    ]
  },
  "pnpm": {
    "overrides": {
      "ajv": "8.18.0",
      "langsmith": "0.5.19",
      "picomatch@^2.0.0": "2.3.2",
      "postcss": "8.5.10",
      "rollup": "4.59.0",
      "terser-webpack-plugin": "5.4.0",
      "uuid": "14.0.0",
      "vite": "8.0.10",
      "yaml": "2.8.3"
    }
  }
}
