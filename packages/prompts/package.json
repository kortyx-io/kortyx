{
  "name": "@kortyx/prompts",
  "version": "0.1.0",
  "description": "Typed, versioned prompts and portable Studio serving for Kortyx.",
  "license": "Apache-2.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist/**",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsc --watch",
    "type-check": "tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run && pnpm -s type-check",
    "coverage": "vitest run --coverage && pnpm -s type-check",
    "lint": "biome check src test"
  },
  "dependencies": {
    "ajv": "8.18.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "@types/node": "catalog:"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kortyx-io/kortyx.git",
    "directory": "packages/prompts"
  }
}
