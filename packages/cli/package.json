{
  "name": "@kortyx/cli",
  "version": "0.4.0",
  "private": false,
  "description": "CLI tooling for Kortyx.",
  "keywords": [
    "ai",
    "agent",
    "agents",
    "orchestration",
    "framework",
    "cli",
    "kortyx"
  ],
  "license": "Apache-2.0",
  "homepage": "https://kortyx.io/",
  "bugs": {
    "url": "https://github.com/kortyx-io/kortyx/issues"
  },
  "author": "Kortyx (https://github.com/kortyx-io)",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "kortyx": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist/**",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "lint": "biome check .",
    "test": "vitest run && pnpm -s type-check",
    "coverage": "vitest run --coverage && pnpm -s type-check",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit -p tsconfig.test.json"
  },
  "dependencies": {
    "@kortyx/agent": "workspace:*",
    "@kortyx/core": "workspace:*",
    "@kortyx/telemetry-contracts": "workspace:*",
    "commander": "^14.0.3",
    "execa": "^9.6.1",
    "tsx": "^4.21.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kortyx-io/kortyx.git",
    "directory": "packages/cli"
  },
  "publishConfig": {
    "access": "public"
  }
}
