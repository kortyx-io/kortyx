{
  "name": "@kortyx/usage-telemetry",
  "version": "0.5.0",
  "private": false,
  "description": "Bounded, privacy-preserving product usage telemetry for Kortyx.",
  "license": "Apache-2.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "browser": "./dist/browser-node.js",
      "default": "./dist/node.js"
    }
  },
  "files": [
    "dist/**",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsc --watch",
    "lint": "biome check src test",
    "test": "vitest run && pnpm -s type-check",
    "type-check": "tsc --noEmit -p tsconfig.test.json",
    "coverage": "vitest run --coverage && pnpm -s type-check"
  },
  "dependencies": {},
  "devDependencies": {
    "tsup": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "@vitest/coverage-v8": "catalog:"
  },
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/kortyx-io/kortyx.git",
    "directory": "packages/usage-telemetry"
  },
  "publishConfig": {
    "access": "public"
  }
}
