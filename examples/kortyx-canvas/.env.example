#
# Copy to .env.local for Next.js
#

# LLM provider
GOOGLE_API_KEY=

# Local dev port used by package.json
KORTYX_CANVAS_PORT=3002

# Framework persistence (interrupt/resume checkpoints + pending requests)
KORTYX_REDIS_URL=redis://127.0.0.1:6379

# Optional: TTL for framework persistence (milliseconds)
KORTYX_FRAMEWORK_TTL_MS=900000

# Optional: send this example's runtime telemetry to Kortyx Studio.
# These defaults match the root docker-compose.yml OSS stack.
KORTYX_TELEMETRY_API_URL=http://localhost:6400
KORTYX_TELEMETRY_API_KEY=ktyx_test_localtelemetry_oss-demo-telemetry-secret-change-me
KORTYX_TELEMETRY_ENVIRONMENT=development
KORTYX_TELEMETRY_SERVICE_NAME=kortyx-canvas
KORTYX_TELEMETRY_DEPLOYMENT_REF=local-canvas
KORTYX_TELEMETRY_CAPTURE_CONTENT=false
