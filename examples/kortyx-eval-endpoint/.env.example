# Application handler key, >=32 characters; match it in the Studio target file.
EVAL_SERVICE_KEY=
# The consumer workflow uses this provider key. Studio judge has its own configuration.
OPENROUTER_API_KEY=
WORKFLOW_MODEL=openai/gpt-4o
PORT=3210
# Optional: enable an App judge for `pnpm eval` / Studio's App selection.
# APP_JUDGE_MODEL=openai/gpt-4o
